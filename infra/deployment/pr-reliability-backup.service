[Unit]
Description=Back up PR Reliability application and Temporal databases
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/pr-reliability-platform
UMask=0077
ExecStart=/usr/bin/python3 -m infra.deployment.database --env-file /etc/pr-reliability/deployment.env backup /var/backups/pr-reliability
