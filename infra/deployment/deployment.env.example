# Copy outside the repository, for example to /etc/pr-reliability/deployment.env.
# Replace every example digest and secret value before running preflight.py.
DEPLOYMENT_ENV_FILE=/etc/pr-reliability/deployment.env
PRIVATE_BIND_ADDRESS=10.0.0.10
PRIVATE_HOSTNAME=reviews.internal.example
PRIVATE_BASE_URL=https://reviews.internal.example
PROMETHEUS_URL=http://127.0.0.1:9090

PLATFORM_IMAGE=registry.example/pr-reliability@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ACTIVITY_WORKER_IMAGE=registry.example/pr-reliability-provider@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
POSTGRES_IMAGE=postgres@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
TEMPORAL_IMAGE=temporalio/auto-setup@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
CADDY_IMAGE=caddy@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
PROMETHEUS_IMAGE=prom/prometheus@sha256:1111111111111111111111111111111111111111111111111111111111111111

TLS_CERTIFICATE_FILE=/etc/pr-reliability/secrets/tls.crt
TLS_PRIVATE_KEY_FILE=/etc/pr-reliability/secrets/tls.key
TLS_CA_FILE=/etc/pr-reliability/secrets/ca.crt
POSTGRES_PASSWORD_FILE=/etc/pr-reliability/secrets/postgres-password
GITHUB_PRIVATE_KEY_FILE=/etc/pr-reliability/secrets/github-app.pem
SANDBOX_DOCKER_SOCKET=/run/user/1001/docker.sock
SANDBOX_ENGINE_UID=1001
SANDBOX_ENGINE_GID=1001
SANDBOX_STAGING_DIRECTORY=/run/user/1001/pr-reliability-sandbox-staging
BACKUP_DIRECTORY=/var/backups/pr-reliability
DEPLOYMENT_SECRET_GID=2001

POSTGRES_USER=pr_reliability
POSTGRES_DB=pr_reliability
DATABASE_URL=postgresql://pr_reliability:replace-with-url-escaped-password@postgres:5432/pr_reliability
OWNER_ID=01J00000000000000000000001
GITHUB_APP_ID=1
GITHUB_INSTALLATION_ID=1
GITHUB_WEBHOOK_SECRET=replace-with-random-secret
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github_private_key
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pr-review
HEALTH_CHECK_TIMEOUT_SECONDS=2
REVIEW_ACTIVITY_OPERATIONS_FACTORY=provider:create_operations
MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-provider-secret
