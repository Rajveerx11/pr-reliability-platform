FROM python:3.12-slim@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36
COPY --from=ghcr.io/astral-sh/uv:0.11.7@sha256:240fb85ab0f263ef12f492d8476aa3a2e4e1e333f7d67fbdd923d00a506a516a /uv /bin/uv
# Only locked dependencies, including pytest/ruff, enter the sandbox. No product source,
# Git client, Docker socket, credentials, or build arguments are installed here.
COPY pyproject.toml uv.lock /tmp/locked-dependencies/
RUN cd /tmp/locked-dependencies \
    && uv export --frozen --extra dev --no-dev --no-emit-project --output-file requirements.txt \
    && uv pip install --system --require-hashes --requirements requirements.txt \
    && rm -rf /tmp/locked-dependencies /root/.cache
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 65534:65534
WORKDIR /workspace
