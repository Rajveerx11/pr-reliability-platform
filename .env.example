# Host-process template. Copy once; never overwrite an existing .env.
# Load explicitly: uv run --env-file .env <entrypoint>
# See docs/configuration.md and docs/development.md for setup and role boundaries.
APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_reliability
OWNER_ID=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_ENCRYPTION_KEY=
GITHUB_LOGIN_ORIGIN=https://reviews.internal.example
GITHUB_ALLOWED_ACCOUNT_ID=
GITHUB_ADMIN_IDS=
GITHUB_REVIEWER_IDS=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pr-review
# Optional: requires a host-reachable collector; local Compose does not publish OTLP.
# Use http://otel-collector:4318 when loading this template for Compose instead.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_METRICS_PORT=8889
OTEL_HEALTH_PORT=13133
HEALTH_CHECK_TIMEOUT_SECONDS=2
API_PORT=8000
# Local Compose requires a reviewed activity-worker override; see docs/development.md.
ACTIVITY_WORKER_IMAGE=
REVIEW_ACTIVITY_OPERATIONS_FACTORY=pr_reliability_workers.providers:create_operations
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_BOT_USER_ID=
GITHUB_WEBHOOK_SECRET=
# Private dashboard page used by GitHub Check Run detail links.
DASHBOARD_BASE_URL=http://localhost:8000/dashboard
# Absolute path to a private key file outside the checkout; never paste key contents.
GITHUB_PRIVATE_KEY_PATH=
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=4096
OPENAI_TIMEOUT_SECONDS=120
GITHUB_API_TIMEOUT_SECONDS=10
GITHUB_CHECKOUT_TIMEOUT_SECONDS=120
# Linux activity host: existing private absolute directory and operator-approved checks.
SANDBOX_STAGING_DIRECTORY=
# JSON list. Each entry fixes one allowed name, immutable image, command, and optional maxima.
REVIEW_CHECK_ALLOWLIST_JSON='[{"name":"python-tests","image":"registry.example/checks@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa","command":["python","-m","pytest","-q"]}]'

